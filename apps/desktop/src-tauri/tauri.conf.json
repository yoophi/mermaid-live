{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mermaid Live",
  "version": "2026.8.1-rc.1",
  "identifier": "dev.yoophi.mermaid-live",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mermaid Live",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "tabbingIdentifier": "mermaid-live-editor"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
